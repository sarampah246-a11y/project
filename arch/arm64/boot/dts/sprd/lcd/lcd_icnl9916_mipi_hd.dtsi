/ {
	fragment {
		target-path = "/";
		__overlay__ {
			lcds {
				lcd_icnl9916_mipi_hd_easyquick_chipone: lcd_icnl9916_mipi_hd_easyquick_chipone {
					zte,panel-name = "BOE_YIKUAILAI_lcd_icnl9916_mipi_hd_chipone";
					zte,lcd-init-code-version = "20230504_V2";
					zte,lcd_bl_vsp_vsn_voltage = <0x14>;
					zte,lcd-delay-open-bl-value = <30>;
					zte,lcd-driver-num-value = <0x9916>;

					sprd,dsi-work-mode = <1>; /* video burst mode*/
					sprd,dsi-lane-number = <4>;
					sprd,dsi-color-format = "rgb888";

					sprd,phy-bit-clock = <810000>;	/* kbps */	/* dpi_clock*6*/
					sprd,phy-escape-clock = <20000>;/* kHz */

					sprd,width-mm = <67930>;/*zte mod for 6.56*/
					sprd,height-mm = <152090>;/*zte mod for 6.56*/

					sprd,esd-check-enable = <1>;
					sprd,esd-check-mode = <1>;
					sprd,esd-check-period = <1000>;
					sprd,esd-check-register = <0x0A>;
					sprd,esd-check-value = <0x9C>;

					sprd,dpi-clk-div = <6>;
					sprd,video-lp-cmd-enable = <1>;
					sprd,hporch-lp-disable = <1>;
					sprd,vrr-enable;

					lcd-glass = "BOE";
					lcd-module = "YIKUAILAI";
					lcd-name = "ICNL9916";

					sprd,reset-on-sequence = <1 15>, <0 1>, <1 15>;
					sprd,reset-off-sequence = <1 20>;

					sprd,use-dcs-write;
					sprd,initial-command = [
								39 00 00 03 F0 5A 59
								39 00 00 03 F1 A5 A6
								39 00 00 02 D4 31
