								39 00 00 0A BF 0C 19 0C 19 00 11 04 18 50
								39 00 00 21 CA 00 40 00 19 46 94 41 8F 44 44 50 50 5A 5A 64 64 32 32 11 00 01 01 0A 06 22 00 05 00 00 5A 5A 04
								39 00 00 03 FB 54 54
								39 00 00 21 C7 73 10 01 23 45 67 77 77 30 73 10 01 23 45 67 77 77 30 31 00 01 FF FF 40 22 22 43 00 00 00 00 00
								39 00 00 21 80 FF FD F8 F5 F1 EE EA E8 E5 DA D1 BF AD 9D 90 83 78 77 6C 61 55 49 3D 2D 23 16 12 0F 0D 0A 07 04
								39 00 00 21 81 FF FD F8 F5 F1 EE EA E8 E5 DA D1 BF AD 9D 90 83 78 77 6C 61 55 49 3D 2D 23 16 12 0F 0D 0A 07 04
								39 00 00 21 82 FF FD F8 F5 F1 EE EA E8 E5 DA D1 BF AD 9D 90 83 78 77 6C 61 55 49 3D 2D 23 16 12 0F 0D 0A 07 04
								39 00 00 0E 83 01 01 01 01 01 01 01 00 00 00 00 00 00
								39 00 00 1C 84 0D DC 6A 22 64 2B AC 51 E0 0D DC 6A 22 64 2B AC 51 E0 0D DC 6A 22 64 2B AC 51 E0
								39 00 00 03 F1 5A 59
								39 00 00 03 F0 A5 A6
								39 00 00 03 35 00 00
								39 78 00 03 11 00 00
								39 20 00 03 29 00 00
								39 05 00 03 6D 02 00

						];
					sprd,sleep-in-command = [
								39 00 00 03 F0 5A 59
								39 00 00 03 F1 A5 A6
								39 00 00 09 BB 01 02 03 0A 04 13 14 00
								39 00 00 03 6D 25 00
								39 0A 00 03 28 00 00
								39 78 00 03 10 00 00
								39 00 00 03 F1 5A 59
								39 05 00 03 F0 A5 A6
						];
					sprd,sleep-out-command = [
								39 00 00 03 F0 5A 59
								39 00 00 03 F1 A5 A6
								39 00 00 09 BB 01 02 03 0A 04 13 14 00
								39 78 00 03 11 00 00
								39 0A 00 03 29 00 00
								39 00 00 03 6D 02 00
								39 00 00 03 F1 5A 59
								39 00 00 03 F0 A5 A6
						];

					display-timings {
						native-mode = <&icnl9916_timing0>;

						icnl9916_timing0:timing0 {
							clock-frequency = <135000000>;
							hactive = <720>;
							vactive = <1612>;
							hback-porch = <76>;
							hfront-porch = <44>;
							vback-porch = <32>;
							vfront-porch = <1020>;
							hsync-len = <4>;
							vsync-len = <4>;
						};
						icnl9916_timing1:timing1 {
							clock-frequency = <135000000>;
							hactive = <720>;
							vactive = <1612>;
							hback-porch = <24>;
							hfront-porch = <24>;
							vback-porch = <32>;
							vfront-porch = <300>;
							hsync-len = <4>;
							vsync-len = <4>;
						};
