			];
		sprd,sleep-in-command = [
			15 32 00 02 28 00
			15 78 00 02 10 00
			];
		sprd,sleep-out-command = [
			05 78 00 01 11
			05 32 00 01 29
			];

		display-timings {
			lcd_st7123_easyquick_hd_timing0: timing0 {
			clock-frequency = <96000000>;
			hactive = <720>;
			vactive = <1600>;
			hback-porch = <68>;
			hfront-porch = <68>;
			vback-porch = <28>;
			vfront-porch = <220>;
			hsync-len = <4>;
			vsync-len = <6>;
			};
		};

		oled-backlight {
			default-brightness-level = <1632>;
			sprd,max-level = <4095>;
			brightness-levels = [
				39 00 00 03 51 00 00
				39 00 00 02 53 2C
			];
		};
